  "query": "\n        SELECT\n            a.id,\n            a.name,\n            a.hostname,\n            a.platform,\n            a.agent_version,\n            a.last_seen_at,\n            a.created_at,\n            c.connected_at,\n            c.ip_address\n        FROM agents a\n        JOIN agent_connections c ON a.id = c.agent_id AND c.disconnected_at IS NULL\n        ORDER BY a.name ASC\n        ",
